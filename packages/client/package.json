{
  "name": "@learn-languages/client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:ci": "tsc && pnpm run build",
    "build:debug": "vite build --debug",
    "build:dev": "vite build --mode development",
    "depcheck": "pnpm dlx depcheck",
    "lint": "eslint 'src/**/*.{tsx,ts}' --quiet --max-warnings 1",
    "lint:fix": "eslint 'src/**/*.{tsx,ts}' --fix ",
    "lint:warn": "eslint 'src/**/*.{tsx,ts}'",
    "start": "vite",
    "start:debug": "vite --debug",
    "test": "echo \"TODO: vitest run\"",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "update": "pnpm dlx npm-check -u -E -s"
  },
  "dependencies": {
    "@ant-design/icons": "5.3.6",
    "@apollo/client": "3.11.10",
    "@fontsource/roboto": "5.0.12",
    "@learn-languages/common": "workspace:^",
    "antd": "5.22.1",
    "ky": "1.7.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@learn-languages/eslint-common": "workspace:^",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-basic-ssl": "1.1.0",
    "@vitejs/plugin-react": "4.3.3",
    "@vitest/ui": "1.6.0",
    "autoprefixer": "10.4.19",
    "jsdom": "25.0.1",
    "postcss": "8.4.38",
    "sass": "1.81.0",
    "vitest": "1.6.0"
  }
}
